# Prisma CLI only. Runtime data uses this project's DB Cloudflare D1 binding.
DATABASE_URL="file:./prisma/dev.db"

# Local application URLs and authentication.
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="replace-with-a-random-demo-only-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Offline/task settings.
GEOFENCE_RADIUS_METERS="200"
MIN_EVIDENCE_PHOTOS="3"
# Maps. Set the provider to "google" and fill both values below to use Google
# Maps (Places autocomplete + geocoding); leave either empty and the app falls
# back to Leaflet on its own. NEXT_PUBLIC_* is inlined at BUILD time, so these
# must be set before the build runs -- not in wrangler.jsonc, whose vars are
# runtime only and never reach the browser bundle.
# The Map ID is required: Google AdvancedMarker will not render without one.
NEXT_PUBLIC_MAPS_PROVIDER="google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# External communications are opt-in and disabled for this demo.
ENABLE_EXTERNAL_EMAIL="false"
ENABLE_EXTERNAL_WHATSAPP="false"
NEXT_PUBLIC_ENABLE_EXTERNAL_WHATSAPP="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
