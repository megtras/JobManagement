{
  "name": "megtras-job-management-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack -p 3100",
    "build": "next build --turbopack",
    "start": "next start -p 3100",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "pwa:build": "npm run build && npm start",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply jobmanagement-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jobmanagement-db --remote",
    "db:seed:local": "wrangler d1 execute jobmanagement-db --local --file prisma/seed.sql",
    "db:seed:remote": "wrangler d1 execute jobmanagement-db --remote --file prisma/seed.sql"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.5.1",
    "@serwist/next": "^9.5.11",
    "@vis.gl/react-google-maps": "^1.8.3",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "serwist": "^9.5.11",
    "sharp": "^0.34.5",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
