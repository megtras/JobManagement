# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded files (stored on VPS, not in repo)
/uploads
/public/uploads
/demo-data
/public/sw.js
# Website photo source files are local working assets. Only optimized files
# under public/website/photos are deployed.
/assets/website/photos-original/*
!/assets/website/photos-original/.gitkeep
/assets/website/photos-edited/*
!/assets/website/photos-edited/.gitkeep
